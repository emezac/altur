# --- Entorno ---
APP_ENV=local_dev

# --- Base de datos ---
DATABASE_URL=sqlite:///./dev.db
# En local_docker / cloud: postgresql+psycopg://user:pass@host:5432/call_analyzer

# --- Cola ---
# Dejar vacío para activar modo burst con fakeredis (LOCAL_DEV)
REDIS_URL=

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/audio
S3_BUCKET_NAME=
# S3_ENDPOINT_URL: setear a http://localhost:9000 para MinIO
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Proveedores ---
# STT_PROVIDER: fake | openai
STT_PROVIDER=fake
# LLM_PROVIDER: fake | openai
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Feature flags ---
ENABLE_VAD_CHUNKING=false
ENABLE_PII_REDACTION=false
MAX_UPLOAD_MB=100
# FAKE_PROCESSING_DELAY_SECONDS: simula latencia en providers fake para ver el polling en la UI
FAKE_PROCESSING_DELAY_SECONDS=2

# --- Seguridad / app ---
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173
